<mxfile host="app.diagrams.net"><diagram name="AS ABAP - Sessoes e memoria" id="as-abap---sessoes-e-memoria"><mxGraphModel dx="1169" dy="827" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0" adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Sessões e memória no AS ABAP" style="text;html=1;fontFamily=Helvetica;fontSize=24;fontStyle=1;fontColor=#002A86;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1090" height="40" as="geometry"/></mxCell><mxCell id="sub" value="Uma instância do servidor de aplicação: memória compartilhada, sessões do usuário e o work process que as executa" style="text;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#475E75;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1090" height="30" as="geometry"/></mxCell><mxCell id="z-shm" value="Memória compartilhada da instância · visível a todos os usuários e work processes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;absoluteArcSize=1;strokeWidth=1.5;fontFamily=Helvetica;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=16;fontStyle=1;strokeColor=#0070F2;fillColor=#EBF8FF;fontColor=#00185A;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1090" height="110" as="geometry"/></mxCell><mxCell id="s-shmo" value="&lt;b&gt;Shared Objects&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#556B82;font-weight:normal;&quot;&gt;objetos em áreas de shared memory&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;absoluteArcSize=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;fontColor=#1D2D3E;strokeColor=#07838F;fillColor=#DAFDF5;" vertex="1" parent="z-shm"><mxGeometry x="20" y="40" width="330" height="50" as="geometry"/></mxCell><mxCell id="s-buf" value="&lt;b&gt;Buffers de tabela&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#556B82;font-weight:normal;&quot;&gt;tabelas com buffering no Dictionary&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;absoluteArcSize=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;fontColor=#1D2D3E;strokeColor=#07838F;fillColor=#DAFDF5;" vertex="1" parent="z-shm"><mxGeometry x="380" y="40" width="330" height="50" as="geometry"/></mxCell><mxCell id="s-pxa" value="&lt;b&gt;Buffer de programas (PXA)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#556B82;font-weight:normal;&quot;&gt;código compilado dos programas&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;absoluteArcSize=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;fontColor=#1D2D3E;strokeColor=#07838F;fillColor=#DAFDF5;" vertex="1" parent="z-shm"><mxGeometry x="740" y="40" width="330" height="50" as="geometry"/></mxCell><mxCell id="z-user" value="Sessão de usuário · criada no logon (até 6 sessões ABAP por padrão)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;absoluteArcSize=1;strokeWidth=1.5;fontFamily=Helvetica;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=16;fontStyle=1;strokeColor=#0070F2;fillColor=#EBF8FF;fontColor=#00185A;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="740" height="520" as="geometry"/></mxCell><mxCell id="u-sap" value="&lt;b&gt;SAP Memory&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#556B82;font-weight:normal;&quot;&gt;SET PARAMETER ID / GET PARAMETER ID · compartilhada por todas as sessões ABAP do usuário&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;absoluteArcSize=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;fontColor=#1D2D3E;strokeColor=#0070F2;fillColor=#FFFFFF;" vertex="1" parent="z-user"><mxGeometry x="20" y="50" width="700" height="50" as="geometry"/></mxCell><mxCell id="f-s1" value="Sessão ABAP 1 · sessão principal (uma janela)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;absoluteArcSize=1;strokeWidth=1.5;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#1D2D3E;strokeColor=#0070F2;fillColor=none;" vertex="1" parent="z-user"><mxGeometry x="20" y="130" width="700" height="220" as="geometry"/></mxCell><mxCell id="a1-mem" value="&lt;b&gt;ABAP Memory&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#556B82;font-weight:normal;&quot;&gt;EXPORT … TO MEMORY ID / IMPORT … FROM MEMORY ID · vale para a sequência de chamadas&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;absoluteArcSize=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;fontColor=#1D2D3E;strokeColor=#0070F2;fillColor=#FFFFFF;" vertex="1" parent="z-user"><mxGeometry x="40" y="170" width="660" height="50" as="geometry"/></mxCell><mxCell id="a1-i1" value="&lt;b&gt;Sessão interna 1&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#556B82;font-weight:normal;&quot;&gt;programa A&lt;br/&gt;dados e objetos próprios&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;absoluteArcSize=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;fontColor=#1D2D3E;strokeColor=#0070F2;fillColor=#FFFFFF;" vertex="1" parent="z-user"><mxGeometry x="40" y="250" width="160" height="80" as="geometry"/></mxCell><mxCell id="a1-i2" value="&lt;b&gt;Sessão interna 2&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#556B82;font-weight:normal;&quot;&gt;programa B&lt;br/&gt;SUBMIT … AND RETURN&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;absoluteArcSize=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;fontColor=#1D2D3E;strokeColor=#0070F2;fillColor=#FFFFFF;" vertex="1" parent="z-user"><mxG