ll><mxCell id="z-wp" value="Work process" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;absoluteArcSize=1;strokeWidth=1.5;fontFamily=Helvetica;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=16;fontStyle=1;strokeColor=#0070F2;fillColor=#EBF8FF;fontColor=#00185A;" vertex="1" parent="1"><mxGeometry x="890" y="240" width="240" height="520" as="geometry"/></mxCell><mxCell id="wp-note" value="A cada passo de diálogo o contexto do usuário é carregado no work process livre e liberado ao final." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#556B82;align=left;verticalAlign=middle;" vertex="1" parent="z-wp"><mxGeometry x="20" y="40" width="200" height="60" as="geometry"/></mxCell><mxCell id="wp-roll" value="&lt;b&gt;Roll area&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#556B82;font-weight:normal;&quot;&gt;parte inicial do contexto&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;absoluteArcSize=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;fontColor=#1D2D3E;strokeColor=#0070F2;fillColor=#FFFFFF;" vertex="1" parent="z-wp"><mxGeometry x="20" y="110" width="200" height="60" as="geometry"/></mxCell><mxCell id="wp-em" value="&lt;b&gt;Extended Memory (EM)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#556B82;font-weight:normal;&quot;&gt;maior parte do contexto,&lt;br/&gt;mapeada no work process&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;absoluteArcSize=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;fontColor=#1D2D3E;strokeColor=#0070F2;fillColor=#FFFFFF;" vertex="1" parent="z-wp"><mxGeometry x="20" y="210" width="200" height="70" as="geometry"/></mxCell><mxCell id="wp-heap" value="&lt;b&gt;Heap · memória privada&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#556B82;font-weight:normal;&quot;&gt;quando a EM se esgota:&lt;br/&gt;modo PRIV, sem troca de usuário&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;absoluteArcSize=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;fontColor=#1D2D3E;strokeColor=#5D36FF;fillColor=#F1ECFF;" vertex="1" parent="z-wp"><mxGeometry x="20" y="320" width="200" height="70" as="geometry"/></mxCell><mxCell id="wp-order" value="Ordem de alocação em um work process de diálogo (simplificada): roll area → Extended Memory → heap." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#556B82;align=left;verticalAlign=middle;" vertex="1" parent="z-wp"><mxGeometry x="20" y="410" width="200" height="90" as="geometry"/></mxCell><mxCell id="e-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475E75;strokeWidth=1.5;endArrow=blockThin;endSize=6;endFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#475E75;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1-i1" target="a1-i2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475E75;strokeWidth=1.5;endArrow=blockThin;endSize=6;endFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#475E75;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1-i2" target="a1-i3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e-ctx" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#475E75;strokeWidth=1.5;endArrow=blockThin;endSize=6;endFill=1;fontFamily=Helvetica;fontSize=10;fontColor=#475E75;labelBackgroundColor=default;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=blockThin;startSize=6;startFill=1;" edge="1" parent="1" source="z-user" target="z-wp"><mxGeometry relative="1" as="geometry"/></mxCell><mx