x="560" y="190" width="220" height="100" as="geometry"/></mxCell><mxCell id="u1" value="&lt;b&gt;Work process de atualização&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#556B82;font-weight:normal;&quot;&gt;os módulos de update registrados&lt;br/&gt;executam as gravações&lt;br/&gt;em uma única LUW de banco&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;absoluteArcSize=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;fontColor=#1D2D3E;strokeColor=#5D36FF;fillColor=#F1ECFF;" vertex="1" parent="z-luw"><mxGeometry x="840" y="190" width="220" height="100" as="geometry"/></mxCell><mxCell id="z-db" value="Banco de dados · uma LUW de banco por passo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;absoluteArcSize=1;strokeWidth=1.5;fontFamily=Helvetica;container=1;collapsible=0;recursiveResize=0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=16;fontStyle=1;strokeColor=#0070F2;fillColor=#EBF8FF;fontColor=#00185A;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="1090" height="150" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;LUW de banco 1&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#556B82;font-weight:normal;&quot;&gt;só leituras&lt;br/&gt;termina em commit implícito&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;absoluteArcSize=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;fontColor=#1D2D3E;strokeColor=#0070F2;fillColor=#FFFFFF;" vertex="1" parent="z-db"><mxGeometry x="40" y="50" width="220" height="80" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;LUW de banco 2&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#556B82;font-weight:normal;&quot;&gt;só leituras&lt;br/&gt;termina em commit implícito&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;absoluteArcSize=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;fontColor=#1D2D3E;strokeColor=#0070F2;fillColor=#FFFFFF;" vertex="1" parent="z-db"><mxGeometry x="300" y="50" width="220" height="80" as="geometry"/></mxCell><mxCell id="d3" value="&lt;b&gt;LUW de banco 3&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#556B82;font-weight:normal;&quot;&gt;nenhuma gravação da aplicação&lt;br/&gt;termina com o COMMIT WORK&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;absoluteArcSize=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;fontColor=#1D2D3E;strokeColor=#0070F2;fillColor=#FFFFFF;" vertex="1" parent="z-db"><mxGeometry x="560" y="50" width="220" height="80" as="geometry"/></mxCell><mxCell id="d4" value="&lt;b&gt;LUW de banco da atualização&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#556B82;font-weight:normal;&quot;&gt;todas as gravações juntas&lt;br/&gt;COMMIT ou ROLLBACK&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;absoluteArcSize=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;fontColor=#1D2D3E;strokeColor=#188918;fillColor=#F5FAE5;" vertex="1" parent="z-db"><mxGeometry x="840" y="50" width="220" height="80" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br/&gt;Seta: sequência no tempo ou chamada&lt;br/&gt;Cada passo de diálogo ocupa um work process e fecha uma LUW de banco&lt;br/&gt;ROLLBACK WORK antes do COMMIT WORK descarta os registros e encerra a SAP LUW" style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;absoluteArcSize=1;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;strokeColor=#475E75;fillColor=#FFFFFF;fontColor=#556B82;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="530" height="90" as="geometry"/></mxCell><mxCell id="cloud" value="&lt;b&gt;ABAP Cloud e RAP · SAP LUW controlada&lt;/b&gt;&lt;br/&gt;Fase de modificação: alterações ficam no buffer transacional&lt;br/&gt;Fase de save: COMMIT ENTI